{
  "info": {
    "_postman_id": "b3e0c034-71b3-4682-8924-a71dd2c505b2",
    "name": "Posts DDD API",
    "description": "Postman collection for Posts backend system (DDD + MongoDB + Kafka)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health"
        },
        "description": "Check if API server is up and healthy."
      },
      "response": []
    },
    {
      "name": "2. Create Post (Emits Kafka Event)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.success && json.data && json.data.id) {",
              "    pm.collectionVariables.set('postId', json.data.id);",
              "    console.log('Saved postId: ' + json.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Domain-Driven Design with Kafka\",\n  \"content\": \"Testing event-driven flow with MongoDB and Apache Kafka.\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/posts"
        },
        "description": "Creates a new post in MongoDB and publishes an event to Kafka."
      },
      "response": []
    },
    {
      "name": "3. List All Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/posts"
        },
        "description": "Retrieves all posts sorted by creation date."
      },
      "response": []
    },
    {
      "name": "4. Get Post by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/posts/{{postId}}"
        },
        "description": "Retrieves a single post by its ID."
      },
      "response": []
    }
  ]
}
